#!/usr/bin/env bash
# ==============================================================================
# ORDO JK&C — DEALS V2.0.0 FORGE PRODUCTION APPLICATION ROLLBACK PROCEDURE
# Target Site: ordo.jknc.io
# Server: jkandc (Ubuntu 24.04 LTS)
# Site Directory: /home/forge/ordo.jknc.io
# Rollback Target Release: /home/forge/ordo.jknc.io/releases/1795769650
# Rollback Target SHA: 9bac901ee6c5abe6891c930dcf1efcd110c8472f (Transmittal V2)
# Scope: Application-only atomic symlink reversion with ZERO DATA LOSS.
#
# EMPIRICAL BACKWARD COMPATIBILITY:
# Schema backward compatibility is NOT assumed; it must be empirically certified
# by DEALS-V2-FORGE-ISOLATED-REHEARSAL.sh via rehearsal_compatibility_bcc2416.env.
# Live database restoration is strictly prohibited during code rollback to
# preserve all active customer transactions and business records.
# ==============================================================================
set -euo pipefail
umask 077

LOCK_DIR="${LOCK_DIR:-/home/forge/.ordo_locks}"
mkdir -p "$LOCK_DIR"
chmod 700 "$LOCK_DIR"
LOCK_FILE="${LOCK_DIR}/ordo_production_deploy.lock"

exec 8>"$LOCK_FILE"
if ! command -v flock >/dev/null 2>&1; then
    echo "ROLLBACK_ABORT: Mandatory utility 'flock' is missing from host environment." >&2
    exit 40
fi
if ! flock -n 8; then
    echo "ROLLBACK_ABORT: Another deployment, rollback, or maintenance operation is currently active." >&2
    exit 40
fi
echo "ROLLBACK_LOCK_ACQUIRED: Lock=$LOCK_FILE PID=$$"

SITE_DIR="${SITE_DIR:-/home/forge/ordo.jknc.io}"
TARGET_PREV_RELEASE="1795769650"
TARGET_PREV_SHA="9bac901ee6c5abe6891c930dcf1efcd110c8472f"
PREV_RELEASE_DIR="${SITE_DIR}/releases/${TARGET_PREV_RELEASE}"
EXPECTED_CANDIDATE_SHA="bcc2416739dea5cb805fe6196b5c1e904c70860b"
BACKUP_DIR="${BACKUP_DIR:-/home/forge/ordo-db-backups}"

ROLLBACK_STEP="INIT"
MAINTENANCE_ENTERED="false"

cleanup() {
    local EXIT_CODE=$?
    if [ "$EXIT_CODE" -ne 0 ]; then
        echo "ROLLBACK_HALTED: Rollback failed at step [$ROLLBACK_STEP] with exit code $EXIT_CODE." >&2
        if [ "$MAINTENANCE_ENTERED" = "true" ]; then
            echo "EMERGENCY_PROTECTION: Ensuring application remains safely in MAINTENANCE MODE to prevent user impact." >&2
            if [ -d "${SITE_DIR}/current" ]; then
                cd "${SITE_DIR}/current"
                php artisan down --render="errors::503" --secret="ordo-rollback-emergency" 2>/dev/null || true
            fi
        else
            echo "SAFE_ABORT: Preliminary validation failed prior to maintenance mode. Active state untouched." >&2
        fi
    fi
    flock -u 8 2>/dev/null || true
}
trap cleanup EXIT INT TERM

echo "======================================================================"
echo "ORDO DEALS V2.0.0 PRODUCTION APPLICATION ROLLBACK INITIATED"
echo "Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "Target Release: $TARGET_PREV_RELEASE ($TARGET_PREV_SHA)"
echo "Mode: Application Code & Symlink Reversion (Data Preserving)"
echo "======================================================================"

# 1. Verify previous release directory exists and commit matches expected baseline
ROLLBACK_STEP="VERIFY_TARGET_RELEASE"
if [ ! -d "$PREV_RELEASE_DIR" ]; then
    echo "ROLLBACK_ABORT: Target previous release directory not found: $PREV_RELEASE_DIR" >&2
    exit 41
fi

PREV_SHA=$(git -C "$PREV_RELEASE_DIR" rev-parse HEAD 2>/dev/null || echo "UNKNOWN")
if [ "$PREV_SHA" != "$TARGET_PREV_SHA" ]; then
    echo "ROLLBACK_ABORT: Target release commit [$PREV_SHA] does not match expected baseline [$TARGET_PREV_SHA]." >&2
    exit 42
fi

# 2. Verify current release identity matches the exact Deals candidate SHA
ROLLBACK_STEP="VERIFY_CURRENT_RELEASE_IDENTITY"
CURRENT_ACTIVE_PATH=$(readlink -f "${SITE_DIR}/current" || true)
if [ -z "$CURRENT_ACTIVE_PATH" ] || [ ! -d "$CURRENT_ACTIVE_PATH" ]; then
    echo "ROLLBACK_ABORT: Current release symlink does not exist or is invalid: ${SITE_DIR}/current" >&2
    exit 43
fi
if [ "$CURRENT_ACTIVE_PATH" = "$PREV_RELEASE_DIR" ]; then
    echo "ROLLBACK_ABORT: Production is already running target previous release $TARGET_PREV_RELEASE ($CURRENT_ACTIVE_PATH)." >&2
    exit 44
fi

CURRENT_ACTIVE_SHA=$(git -C "$CURRENT_ACTIVE_PATH" rev-parse HEAD 2>/dev/null || echo "UNKNOWN")
echo "CURRENT_ACTIVE_RELEASE: Path=$CURRENT_ACTIVE_PATH SHA=$CURRENT_ACTIVE_SHA"
if [ "$CURRENT_ACTIVE_SHA" != "$EXPECTED_CANDIDATE_SHA" ]; then
    echo "ROLLBACK_ABORT: Active release commit [$CURRENT_ACTIVE_SHA] does not match Deals candidate [$EXPECTED_CANDIDATE_SHA]." >&2
    exit 45
fi

# 3. Require genuine backward compatibility evidence from rehearsal database
ROLLBACK_STEP="VERIFY_BACKWARD_COMPATIBILITY_EVIDENCE"
COMPATIBILITY_FILE="${BACKUP_DIR}/rehearsal_compatibility_${EXPECTED_CANDIDATE_SHA}.env"
echo "Validating schema backward compatibility certificate..."
if [ ! -f "$COMPATIBILITY_FILE" ]; then
    echo "ROLLBACK_ABORT: Backward compatibility certificate missing at $COMPATIBILITY_FILE." >&2
    echo "Empirical backward compatibility must be certified during isolated rehearsal before rollback." >&2
    exit 46
fi

# shellcheck disable=SC1090
source "$COMPATIBILITY_FILE"

if [ "${COMPATIBILITY_STATUS:-}" != "PASS" ] || [ "${CANDIDATE_SHA:-}" != "$EXPECTED_CANDIDATE_SHA" ]; then
    echo "ROLLBACK_ABORT: Backward compatibility validation failed in $COMPATIBILITY_FILE." >&2
    echo "Status=${COMPATIBILITY_STATUS:-NONE}, SHA=${CANDIDATE_SHA:-NONE}" >&2
    exit 47
fi
echo "BACKWARD_COMPATIBILITY_CONFIRMED: Queries=${QUERIES_VERIFIED:-PASS} Release=${PREVIOUS_RELEASE_ID:-1795769650}"

# 4. Preliminary validation passed; enter maintenance mode
ROLLBACK_STEP="ENTER_MAINTENANCE_MODE"
echo "Entering maintenance mode..."
cd "$CURRENT_ACTIVE_PATH"
php artisan down --render="errors::503" --secret="ordo-rollback-emergency"
MAINTENANCE_ENTERED="true"

# 5. Data preservation confirmation (Zero destructive DB restoration)
echo "DATA_PRESERVATION: Additive schema preserved. All production transactions and customer records remain 100% intact."
echo "CRITICAL_SAFETY: Zero destructive database restore executed."

# 6. Atomic Symlink Switchback to Previous Release
ROLLBACK_STEP="ATOMIC_SYMLINK_REVERSION"
echo "ATOMIC_SYMLINK_REVERSION: Pointing ${SITE_DIR}/current -> $PREV_RELEASE_DIR"
ln -sfn "$PREV_RELEASE_DIR" "${SITE_DIR}/current_tmp"
mv -Tf "${SITE_DIR}/current_tmp" "${SITE_DIR}/current"

# 7. Re-cache Configuration and Routes on Restored Release
ROLLBACK_STEP="RECACHE_PREV_RELEASE"
cd "$PREV_RELEASE_DIR"
php artisan config:cache
php artisan route:cache
php artisan view:cache

# 8. Service Reload — Fail explicitly if service reload fails
ROLLBACK_STEP="RELOAD_SERVICES"
echo "Reloading php8.5-fpm service and queue workers..."
sudo -n systemctl reload php8.5-fpm
php artisan queue:restart

# 9. Bring Application Back Online
ROLLBACK_STEP="BRING_APPLICATION_ONLINE"
php artisan up

# 10. Post-Rollback Health Verification — Fail explicitly if non-200
ROLLBACK_STEP="POST_ROLLBACK_HEALTHCHECK"
sleep 2
HTTP_CODE=$(curl -fsSI --max-time 15 "https://ordo.jknc.io" | grep -i "HTTP/" | head -n 1 | awk '{print $2}' || echo "FAIL")
if [ "$HTTP_CODE" != "200" ]; then
    echo "ROLLBACK_FAILURE: https://ordo.jknc.io returned HTTP status $HTTP_CODE (expected 200)." >&2
    exit 70
fi

echo "======================================================================"
echo "ROLLBACK_SUCCESSFUL: https://ordo.jknc.io restored to release $TARGET_PREV_RELEASE ($TARGET_PREV_SHA)"
echo "Health Status: HTTP 200 OK"
echo "Production Data: 100% Preserved (Zero destructive DB overwrites)"
echo "======================================================================"
flock -u 8 2>/dev/null || true
exit 0
