<?xml version="1.0" encoding="UTF-8"?>
<!-- Dedicated suite only. Start PHP with tests/Support/transmittal-v1.ini.
     Do not use composer setup, artisan test, or parallel/process-isolated execution.
     No real APP_KEY, database URL, or service credentials belong in this file. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/Support/transmittal-v1-bootstrap.php"
         colors="true"
         cacheResult="false"
         processIsolation="false"
         failOnEmptyTestSuite="true">
    <testsuites>
        <testsuite name="Transmittal V1 isolated regression">
            <file>tests\Feature\TransmittalV1RegressionTest.php</file>
        </testsuite>
    </testsuites>
    <source>
        <include><directory>app</directory></include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_DEBUG" value="false" force="true" verbatim="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
